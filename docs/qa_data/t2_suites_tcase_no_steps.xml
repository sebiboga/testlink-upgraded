<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test Suites with Test Cases (No Steps)
  Shows structure of test cases without detailed steps
  Use for testing test case structure import
-->
<testproject>
  <name>Test Cases Without Steps Project</name>
  <notes>Project with test suites and cases but no steps</notes>
  <testsuites>
    <testsuite>
      <name>Core Features Suite</name>
      <description>Tests for core system features</description>
      <testcases>
        <testcase>
          <name>Feature 1 Basic Test</name>
          <description>Test basic feature 1 functionality</description>
          <preconditions>Feature 1 is accessible</preconditions>
          <execution_type>manual</execution_type>
        </testcase>
        <testcase>
          <name>Feature 2 Basic Test</name>
          <description>Test basic feature 2 functionality</description>
          <preconditions>Feature 2 is accessible</preconditions>
          <execution_type>manual</execution_type>
        </testcase>
        <testcase>
          <name>Feature 3 Integration Test</name>
          <description>Test feature 3 with other features</description>
          <preconditions>Features 1, 2, 3 are accessible</preconditions>
          <execution_type>manual</execution_type>
        </testcase>
      </testcases>
    </testsuite>
    <testsuite>
      <name>Advanced Features Suite</name>
      <description>Tests for advanced system features</description>
      <testcases>
        <testcase>
          <name>Advanced Feature 1 Test</name>
          <description>Test advanced feature 1</description>
          <preconditions>User has admin privileges</preconditions>
          <execution_type>manual</execution_type>
        </testcase>
        <testcase>
          <name>Advanced Feature 2 Test</name>
          <description>Test advanced feature 2</description>
          <preconditions>User has admin privileges</preconditions>
          <execution_type>automated</execution_type>
        </testcase>
      </testcases>
    </testsuite>
  </testsuites>
</testproject>
