<?xml version="1.0" encoding="UTF-8"?>
<!--
  Empty Test Suites Example
  Test project with suites but no test cases
  Use for testing suite-only import functionality
-->
<testproject>
  <name>Empty Suites Project</name>
  <notes>Project with test suites but no test cases</notes>
  <testsuites>
    <testsuite>
      <name>Authentication Suite</name>
      <description>Tests for user authentication</description>
      <testcases></testcases>
    </testsuite>
    <testsuite>
      <name>User Management Suite</name>
      <description>Tests for user profile management</description>
      <testcases></testcases>
    </testsuite>
    <testsuite>
      <name>Dashboard Suite</name>
      <description>Tests for dashboard functionality</description>
      <testcases></testcases>
    </testsuite>
  </testsuites>
</testproject>
